page {
  --color-system-background: var(--weui-BG-0);
  --color-grouped-background: var(--weui-BG-2);
  --color-primary-text: var(--weui-FG-0);
  --color-secondary-text: var(--weui-FG-1);
  --color-tertiary-text: var(--weui-FG-2);
  --color-separator: var(--weui-FG-3);
  --color-accent: var(--weui-BRAND);
  --color-success: var(--weui-GREEN);
  --color-warning: #fa9d3b;
  --color-danger: var(--weui-RED);
  --radius-card: 16rpx;
  --space-page-x: 32rpx;
  --space-page-y: 24rpx;
  --space-section: 32rpx;
  --font-title: 44rpx;
  --font-section: 32rpx;
  --font-metric: 40rpx;
  --font-body: 28rpx;
  --font-caption: 24rpx;
}

.page {
  min-height: 100vh;
  padding: var(--space-page-y) 0 48rpx;
  background: var(--weui-BG-0);
  box-sizing: border-box;
  color: var(--weui-FG-0);
  font-family: -apple-system-font, "Helvetica Neue", sans-serif;
}

.surface {
  background: var(--weui-BG-2);
}

.section-title {
  padding: 0 var(--space-page-x);
  color: var(--weui-FG-0);
  font-size: var(--font-section);
  font-weight: 600;
  line-height: 1.35;
}

.caption {
  color: var(--weui-FG-1);
  font-size: var(--font-caption);
  line-height: 1.45;
}

.primary-button {
  margin: 0;
  border-radius: 8rpx;
}

.secondary-button {
  margin: 0;
  border-radius: 8rpx;
  background: var(--weui-BG-2);
  color: var(--weui-BRAND);
}

.status-label {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  box-sizing: border-box;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.2;
}

.status-active {
  background: var(--weui-BRAND);
}

.status-due-soon {
  background: var(--color-warning);
}

.status-overdue {
  background: var(--weui-RED);
}

.status-redeemed {
  background: var(--weui-GREEN);
}

.status-cancelled {
  background: var(--weui-FG-2);
}
