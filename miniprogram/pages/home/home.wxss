.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.title {
  font-size: var(--font-title);
  font-weight: 700;
  line-height: 1.3;
}

.subtitle {
  margin-top: 12rpx;
  color: var(--color-secondary-text);
  font-size: var(--font-body);
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: var(--space-section);
}

.asset-edit-button {
  margin-top: 16rpx;
  background: transparent;
  color: var(--color-accent);
  font-size: var(--font-caption);
  line-height: 64rpx;
}

.asset-editor {
  margin-top: 16rpx;
  padding: 24rpx;
}

.asset-editor .section-title {
  margin-bottom: 20rpx;
  font-size: 30rpx;
}

.asset-field {
  width: 100%;
  min-height: 80rpx;
  margin-bottom: 16rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--color-separator);
  border-radius: var(--radius-card);
  box-sizing: border-box;
  font-size: var(--font-body);
}

.asset-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.loading-state,
.error-state {
  margin-top: var(--space-section);
  padding: 24rpx;
  font-size: var(--font-caption);
}

.loading-state {
  color: var(--color-secondary-text);
}

.error-state {
  color: var(--color-danger);
}

.section {
  margin-top: var(--space-section);
}

.section-title {
  margin-bottom: 16rpx;
}

.empty,
.reminder {
  padding: 24rpx;
  border-radius: var(--radius-card);
  background: var(--color-grouped-background);
}

.empty {
  color: var(--color-secondary-text);
  font-size: var(--font-caption);
}

.reminder {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
  color: var(--color-primary-text);
  font-size: var(--font-caption);
}

.reminder--due-soon {
  border-left: 6rpx solid var(--color-warning);
}

.reminder--overdue {
  border-left: 6rpx solid var(--color-danger);
}
