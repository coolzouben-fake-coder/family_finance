.dashboard-hero {
  margin-top: 0;
  padding: 32rpx 32rpx 28rpx;
  background: var(--weui-BG-2);
}

.title {
  font-size: var(--font-title);
  font-weight: 700;
  line-height: 1.3;
}

.subtitle {
  margin-top: 12rpx;
  color: var(--weui-FG-1);
  font-size: var(--font-body);
}

.dashboard-panel {
  margin-top: var(--space-section);
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  padding: 0 24rpx 24rpx;
}

.metric-grid {
  margin-top: 0;
}

.asset-edit-button {
  margin-top: var(--space-section);
}

.asset-editor {
  margin-top: var(--space-section);
  background: var(--weui-BG-2);
}

.asset-type-control {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin: 0 32rpx 24rpx;
  padding: 6rpx;
  border-radius: 12rpx;
  background: var(--weui-BG-1);
}

.asset-type-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 64rpx;
  min-width: 0;
  min-height: 64rpx;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  box-sizing: border-box;
  color: var(--weui-FG-1);
  font-size: var(--font-caption);
  font-weight: 500;
  line-height: 64rpx;
}

.asset-type-control .weui-btn + .weui-btn {
  margin-top: 0;
}

.asset-type-button.weui-btn_default {
  background: transparent;
}

.asset-type-button::after {
  border: 0;
}

.asset-type-button--active {
  background: var(--weui-BRAND);
  color: #FFFFFF;
  font-weight: 700;
  box-shadow: none;
}

.asset-type-button--active.weui-btn_default {
  background: var(--weui-BRAND);
}

.asset-cells {
  margin-top: 0;
}

.asset-field {
  width: 100%;
  min-height: 48rpx;
  padding: 0;
  border: 0;
  box-sizing: border-box;
  font-size: var(--font-body);
  line-height: 48rpx;
}

.asset-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 32rpx;
}

.asset-actions .weui-btn {
  margin: 0;
}

.asset-change-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.asset-change-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.asset-change-title {
  margin-bottom: 8rpx;
  font-size: var(--font-body);
  font-weight: 600;
}

.asset-change-balance {
  flex-shrink: 0;
  color: var(--weui-FG-1);
  font-size: var(--font-caption);
  line-height: 1.6;
  text-align: right;
}

.loading-state,
.error-state {
  margin-top: var(--space-section);
  padding: 28rpx 32rpx;
  font-size: var(--font-caption);
}

.loading-state {
  color: var(--weui-FG-1);
}

.error-state {
  color: var(--color-danger);
}

.section {
  margin-top: var(--space-section);
}

.section-title {
  margin-bottom: 0;
}

.empty,
.reminder {
  min-height: 88rpx;
}

.empty {
  color: var(--weui-FG-1);
  font-size: var(--font-caption);
}

.reminder {
  display: flex;
  justify-content: space-between;
  color: var(--color-primary-text);
  font-size: var(--font-caption);
}

.reminder--due-soon {
  border-left: 6rpx solid var(--color-warning);
}

.reminder--overdue {
  border-left: 6rpx solid var(--color-danger);
}
