<view class="page">
  <button class="primary-button" bindtap="goCreate">新增项目</button>

  <view class="filters">
    <picker mode="selector" range="{{statusOptions}}" range-key="label" bindchange="onStatusChange">
      <view class="filter-control">{{selectedStatusLabel}}</view>
    </picker>
    <picker mode="selector" range="{{categoryOptions}}" range-key="name" bindchange="onCategoryChange">
      <view class="filter-control">{{selectedCategoryLabel}}</view>
    </picker>
    <picker mode="selector" range="{{registrantOptions}}" range-key="nickname" bindchange="onRegistrantChange">
      <view class="filter-control">{{selectedRegistrantLabel}}</view>
    </picker>
    <picker mode="selector" range="{{yearOptions}}" range-key="label" bindchange="onYearChange">
      <view class="filter-control">{{selectedYearLabel}}</view>
    </picker>
  </view>

  <view wx:if="{{loading}}" class="empty caption">正在加载项目</view>
  <view wx:elif="{{errorMessage}}" class="error-state surface">{{errorMessage}}</view>
  <view wx:elif="{{projects.length}}" class="list">
    <project-card wx:for="{{projects}}" wx:key="_id" project="{{item}}" bind:open="openProject" bind:cancel="cancelProject" bind:remove="removeProject" />
  </view>
  <view wx:else class="empty surface">
    <view class="empty-title">暂无符合条件的项目</view>
    <view class="caption">调整筛选条件或新增一笔项目。</view>
  </view>
</view>
