.asset-change-row {
  align-items: flex-start;
  gap: 20rpx;
}

.asset-change-title {
  margin-bottom: 8rpx;
  color: var(--weui-FG-0);
  font-size: var(--font-body);
  font-weight: 600;
}

.asset-change-balance {
  flex-shrink: 0;
  color: var(--weui-FG-1);
  font-size: var(--font-caption);
  line-height: 1.6;
  text-align: right;
}

.empty,
.error-state {
  color: var(--weui-FG-1);
  font-size: var(--font-caption);
}

.error-state {
  color: var(--color-danger);
}

.repay-button {
  margin: 16rpx 0 0;
}

.repay-inline {
  background: var(--weui-BG-1);
  align-items: stretch;
}

.form-label {
  width: 120rpx;
  color: var(--weui-FG-0);
  font-size: var(--font-body);
}

.repay-actions {
  display: flex;
  gap: 20rpx;
  padding-top: 24rpx;
}

.repay-actions button {
  flex: 1;
}

.secondary-button {
  background: var(--weui-BG-1);
  color: var(--weui-FG-0);
}

.input-row {
  padding: 20rpx 0 0;
}

.repay-error {
  padding-top: 16rpx;
}
