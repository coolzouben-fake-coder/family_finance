.form-group {
  margin-bottom: 20rpx;
  padding: 0 24rpx;
}

.form-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  border-bottom: 1rpx solid var(--color-separator);
  box-sizing: border-box;
}

.form-row:last-child {
  border-bottom: 0;
}

.form-row--stacked {
  display: block;
  min-height: 220rpx;
  padding: 22rpx 0;
}

.form-label {
  flex: 0 0 172rpx;
  color: var(--color-primary-text);
  font-size: var(--font-body);
  line-height: 1.3;
}

.field-wrap {
  flex: 1;
  min-width: 0;
}

.field,
.textarea {
  width: 100%;
  min-height: 76rpx;
  padding: 0;
  background: transparent;
  box-sizing: border-box;
  color: var(--color-primary-text);
  font-size: var(--font-body);
  line-height: 76rpx;
  text-align: right;
}

.picker-field {
  overflow: hidden;
  color: var(--color-secondary-text);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.textarea {
  min-height: 144rpx;
  margin-top: 14rpx;
  line-height: 1.5;
  text-align: left;
}

.redeem,
.redeemed-note {
  margin-top: var(--space-section);
  padding: 24rpx;
}

.redeem .section-title {
  margin-bottom: 20rpx;
}

.redeem .form-row {
  padding: 0 0;
}

.history-warning { margin-bottom: 20rpx; color: var(--color-warning); font-size: var(--font-caption); line-height: 1.5; }
.empty-field { flex: 1; min-width: 0; color: var(--color-tertiary-text); box-sizing: border-box; font-size: 26rpx; line-height: 1.4; text-align: right; }
.form-state { padding: 32rpx; text-align: center; }
.error-state { color: var(--color-danger); }
