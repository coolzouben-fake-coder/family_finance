.field, .textarea { width: 100%; margin-bottom: 16rpx; padding: 20rpx; border-radius: var(--radius-card); background: var(--color-grouped-background); box-sizing: border-box; color: var(--color-primary-text); font-size: var(--font-body); }
.picker-field { color: var(--color-secondary-text); }
.textarea { min-height: 160rpx; }
.redeem, .redeemed-note { margin-top: var(--space-section); padding: 24rpx; }
.redeem .section-title { margin-bottom: 20rpx; }
.history-warning { margin-bottom: 20rpx; color: var(--color-warning); font-size: var(--font-caption); line-height: 1.5; }
.empty-field { margin-bottom: 16rpx; padding: 24rpx; border-radius: var(--radius-card); background: var(--color-grouped-background); color: var(--color-tertiary-text); box-sizing: border-box; font-size: 26rpx; }
